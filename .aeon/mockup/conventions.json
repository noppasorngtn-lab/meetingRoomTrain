    },
    {
      "id": "UIC-002",
      "appliesTo": {
        "kinds": [
          "view",
          "edit",
          "delete",
          "manage",
          "command"
        ],
        "screens": "every",
        "text": "ปุ่มประจำแถวทุกปุ่ม"
      },
      "rule": "แสดงเป็นปุ่มตัวหนังสือ ไม่ใช่ไอคอน ใช้ชื่อ action ที่ design ประกาศไว้ใน actions[].name เป็นข้อความบนปุ่มและเป็นชื่อสำหรับ screen reader — ตาม design system mrr ที่กำหนดว่าปุ่มทุกปุ่มต้องมีข้อความ ไม่มีปุ่มไอคอนอย่างเดียว",
      "readsField": "actions[].name",
      "prevents": "an icon with no accessible name (MV15), and a label invented by the renderer that disagrees with the declared name",
      "decides": {
        "presentation": "text",
        "accessibleName": "declared-name"
      },
      "confirmedBy": "Noppasorn",
      "confirmedAt": "2026-10-19T11:10:00Z",
      "supersededBy": null,
      "boundary": "WHAT affordance appears is structure and may sit in a wireframe (an icon button, first column); HOW it looks — which glyph, which colour, how many pixels — is theme and may not (specification 7.3, the MV1 line)",
      "origin": {
        "kind": "template",
        "ref": "plugins/mock/assets/conventions.seed.json",
        "pluginVersion": "0.3.0",
        "importedAt": "2026-10-19T08:30:16Z"
      }
    },
